<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tromsø • Noruega</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#07111f;
    color:white;
}

/* MENU */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    padding:20px 8%;

    display:flex;
    justify-content:space-between;
    align-items:center;

    background:rgba(4,12,24,0.90);
    backdrop-filter:blur(10px);

    z-index:1000;
}

.logo{
    font-size:25px;
    font-weight:bold;
    letter-spacing:2px;
}

.logo span{
    color:#67e8f9;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:25px;
    font-size:15px;
    transition:0.3s;
}

nav a:hover{
    color:#67e8f9;
}

/* INÍCIO */

.inicio{
    min-height:100vh;

    background:
    linear-gradient(
        rgba(2,10,25,0.35),
        rgba(2,10,25,0.85)
    ),
    url("https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=1800&q=80");

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;

    padding:100px 20px 40px;
}

.inicio-conteudo{
    max-width:850px;
}

.inicio h1{
    font-size:75px;
    letter-spacing:5px;
    margin-bottom:20px;
}

.inicio h1 span{
    color:#67e8f9;
}

.inicio p{
    font-size:20px;
    line-height:1.7;
    color:#e5e7eb;
}

.botao{
    display:inline-block;

    margin-top:30px;
    padding:14px 30px;

    background:#67e8f9;
    color:#06101d;

    text-decoration:none;
    border-radius:8px;

    font-weight:bold;
    transition:0.3s;
}

.botao:hover{
    transform:translateY(-4px);
    background:#a5f3fc;
}

/* SEÇÕES */

section{
    padding:90px 8%;
}

.titulo{
    text-align:center;
    margin-bottom:50px;
}

.titulo h2{
    font-size:40px;
    margin-bottom:10px;
}

.titulo span{
    color:#67e8f9;
}

.titulo p{
    color:#94a3b8;
}

/* SOBRE */

.sobre{
    background:#0b1728;
}

.sobre-conteudo{
    max-width:1050px;
    margin:auto;

    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
    align-items:center;
}

.sobre-texto p{
    color:#cbd5e1;
    line-height:1.8;
    margin-bottom:18px;
}

.info-box{
    background:#101f33;
    padding:35px;
    border-radius:15px;
    border:1px solid #1e3a56;
}

.info-box h3{
    color:#67e8f9;
    margin-bottom:20px;
}

.info{
    padding:12px 0;
    border-bottom:1px solid #263b50;
    color:#cbd5e1;
}

.info:last-child{
    border-bottom:none;
}

/* AURORA */

.aurora{
    min-height:500px;

    background:
    linear-gradient(
        rgba(4,15,30,0.70),
        rgba(4,15,30,0.85)
    ),
    url("https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=1800&q=80");

    background-size:cover;
    background-position:center;
    background-attachment:fixed;

    display:flex;
    align-items:center;
}

.aurora-conteudo{
    max-width:850px;
    margin:auto;
    text-align:center;
}

.aurora h2{
    font-size:45px;
    margin-bottom:25px;
}

.aurora h2 span{
    color:#67e8f9;
}

.aurora p{
    color:#e2e8f0;
    line-height:1.8;
    font-size:18px;
}

.aurora p + p{
    margin-top:20px;
}

/* PONTOS TURÍSTICOS */

.pontos{
    background:#07111f;
}

.cards{
    max-width:1100px;
    margin:auto;

    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:#0d1b2d;
    border-radius:12px;
    overflow:hidden;

    border:1px solid #1c334b;

    transition:0.3s;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#67e8f9;
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-conteudo{
    padding:25px;
}

.card h3{
    color:#67e8f9;
    margin-bottom:12px;
    font-size:21px;
}

.card p{
    color:#aebdce;
    line-height:1.6;
}

/* EXPERIÊNCIAS */

.experiencias{
    background:#0b1728;
}

.experiencias-grid{
    max-width:1050px;
    margin:auto;

    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.experiencia{
    background:#101f33;
    padding:30px 20px;
    text-align:center;
    border-radius:12px;

    border:1px solid #1e3a56;
}

.experiencia h3{
    color:#67e8f9;
    margin-bottom:10px;
}

.experiencia p{
    color:#aebdce;
    font-size:14px;
    line-height:1.5;
}

/* CURIOSIDADES */

.curiosidades{
    background:#07111f;
}

.lista{
    max-width:900px;
    margin:auto;
}

.lista div{
    background:#0d1b2d;
    padding:20px;
    margin-bottom:15px;

    border-left:4px solid #67e8f9;
    border-radius:8px;

    color:#dbeafe;
}

/* OUTROS PROJETOS */

.outros-projetos{
    padding:80px 8%;
    background:#0b1728;
    text-align:center;
    border-top:1px solid #162b42;
}

.outros-projetos h2{
    font-size:38px;
    margin-bottom:10px;
}

.outros-projetos h2 span{
    color:#67e8f9;
}

.outros-projetos > p{
    color:#94a3b8;
    margin-bottom:35px;
}

.botoes-projetos{
    max-width:800px;
    margin:auto;

    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
}

.botao-projeto{
    width:280px;

    padding:18px 25px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    background:#101f33;
    border:1px solid #1e3a56;
    border-radius:10px;

    color:white;
    text-decoration:none;

    transition:0.3s;
}

.botao-projeto:hover{
    background:#14283e;
    border-color:#67e8f9;
    transform:translateY(-5px);

    box-shadow:
    0 8px 25px rgba(103,232,249,0.12);
}

.botao-projeto span{
    font-size:16px;
    font-weight:bold;
}

.botao-projeto strong{
    color:#67e8f9;
    font-size:24px;

    transition:0.3s;
}

.botao-projeto:hover strong{
    transform:translateX(6px);
}

/* RODAPÉ */

footer{
    background:#030a13;
    text-align:center;
    padding:35px;
    color:#64748b;
}

footer strong{
    color:#67e8f9;
}

/* RESPONSIVO */

@media(max-width:900px){

    .inicio h1{
        font-size:55px;
    }

    .sobre-conteudo{
        grid-template-columns:1fr;
    }

    .cards{
        grid-template-columns:1fr 1fr;
    }

    .experiencias-grid{
        grid-template-columns:1fr 1fr;
    }

    nav{
        display:none;
    }

}

@media(max-width:600px){

    .inicio h1{
        font-size:42px;
    }

    .inicio p{
        font-size:16px;
    }

    .cards{
        grid-template-columns:1fr;
    }

    .experiencias-grid{
        grid-template-columns:1fr;
    }

    .botoes-projetos{
        flex-direction:column;
        align-items:center;
    }

    .botao-projeto{
        width:100%;
        max-width:350px;
    }

    section{
        padding:70px 6%;
    }

    .titulo h2{
        font-size:32px;
    }

}

</style>

</head>

<body>


<!-- MENU -->

<header>

    <div class="logo">
        TROMS<span>Ø</span>
    </div>

    <nav>

        <a href="#inicio">Início</a>
        <a href="#sobre">Sobre</a>
        <a href="#aurora">Aurora Boreal</a>
        <a href="#pontos">Pontos Turísticos</a>
        <a href="#experiencias">Experiências</a>
        <a href="#curiosidades">Curiosidades</a>

    </nav>

</header>


<!-- INÍCIO -->

<section class="inicio" id="inicio">

    <div class="inicio-conteudo">

        <h1>
            TROMS<span>Ø</span>
        </h1>

        <p>
            Descubra uma das cidades mais fascinantes
            do norte da Noruega, cercada por montanhas,
            fiordes e paisagens árticas.
        </p>

        <a href="#sobre" class="botao">
            Explorar Tromsø
        </a>

    </div>

</section>


<!-- SOBRE -->

<section class="sobre" id="sobre">

    <div class="titulo">

        <h2>
            Sobre <span>Tromsø</span>
        </h2>

        <p>
            Conheça a cidade conhecida como a Capital do Ártico
        </p>

    </div>


    <div class="sobre-conteudo">

        <div class="sobre-texto">

            <p>
                Tromsø é uma cidade localizada no norte da Noruega,
                cerca de 350 quilômetros ao norte do Círculo Polar Ártico.
            </p>

            <p>
                Cercada por montanhas e fiordes, a cidade combina
                vida urbana, cultura e natureza ártica.
            </p>

            <p>
                Durante o inverno, Tromsø é conhecida pelas
                possibilidades de observar a Aurora Boreal.
                No verão, o Sol da Meia-Noite cria dias muito longos.
            </p>

        </div>


        <div class="info-box">

            <h3>Tromsø em números</h3>

            <div class="info">
                País: Noruega
            </div>

            <div class="info">
                Região: Norte da Noruega
            </div>

            <div class="info">
                Localização: acima do Círculo Polar Ártico
            </div>

            <div class="info">
                Conhecida pela Aurora Boreal
            </div>

            <div class="info">
                Conhecida pelo Sol da Meia-Noite
            </div>

        </div>

    </div>

</section>


<!-- AURORA -->

<section class="aurora" id="aurora">

    <div class="aurora-conteudo">

        <h2>
            A <span>Aurora Boreal</span>
        </h2>

        <p>
            Um dos maiores atrativos de Tromsø é a Aurora Boreal.
            O fenômeno pode ser observado durante os meses mais
            escuros do ano, quando as condições são favoráveis.
        </p>

        <p>
            As luzes coloridas no céu são um dos símbolos
            mais marcantes da região do Ártico.
        </p>

    </div>

</section>


<!-- PONTOS TURÍSTICOS -->

<section class="pontos" id="pontos">

    <div class="titulo">

        <h2>
            Pontos <span>Turísticos</span>
        </h2>

        <p>
            Lugares que fazem parte da identidade de Tromsø
        </p>

    </div>


    <div class="cards">


        <div class="card">

            <img
            src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=80"
            alt="Catedral">

            <div class="card-conteudo">

                <h3>Catedral do Ártico</h3>

                <p>
                    Uma das construções mais conhecidas de Tromsø,
                    famosa por sua arquitetura moderna e localização.
                </p>

            </div>

        </div>


        <div class="card">

            <img
            src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80"
            alt="Paisagem de Tromsø">

            <div class="card-conteudo">

                <h3>Fjellheisen</h3>

                <p>
                    Um dos lugares para apreciar a paisagem
                    de Tromsø e das montanhas ao redor.
                </p>

            </div>

        </div>


        <div class="card">

            <img
            src="https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=900&q=80"
            alt="Aurora Boreal">

            <div class="card-conteudo">

                <h3>Polaria</h3>

                <p>
                    Centro de experiências sobre o Ártico,
                    localizado no coração da cidade.
                </p>

            </div>

        </div>


    </div>

</section>


<!-- EXPERIÊNCIAS -->

<section class="experiencias" id="experiencias">

    <div class="titulo">

        <h2>
            Experiências em <span>Tromsø</span>
        </h2>

        <p>
            Natureza, cultura e aventura
        </p>

    </div>


    <div class="experiencias-grid">


        <div class="experiencia">

            <h3>Aurora Boreal</h3>

            <p>
                Observe as luzes do norte durante
                as noites escuras do Ártico.
            </p>

        </div>


        <div class="experiencia">

            <h3>Sol da Meia-Noite</h3>

            <p>
                No verão, o Sol permanece visível
                por longos períodos.
            </p>

        </div>


        <div class="experiencia">

            <h3>Montanhas</h3>

            <p>
                Tromsø é cercada por paisagens
                montanhosas e fiordes.
            </p>

        </div>


        <div class="experiencia">

            <h3>Cultura</h3>

            <p>
                Museus, arte, festivais e história
                fazem parte da cidade.
            </p>

        </div>


    </div>

</section>


<!-- CURIOSIDADES -->

<section class="curiosidades" id="curiosidades">

    <div class="titulo">

        <h2>
            <span>Curiosidades</span>
        </h2>

        <p>
            Algumas informações interessantes
        </p>

    </div>


    <div class="lista">

        <div>
            Tromsø fica acima do Círculo Polar Ártico.
        </div>

        <div>
            A cidade é conhecida mundialmente pela Aurora Boreal.
        </div>

        <div>
            Durante o verão ocorre o fenômeno do Sol da Meia-Noite.
        </div>

        <div>
            A cidade é cercada por montanhas e fiordes.
        </div>

        <div>
            A região oferece diversas experiências relacionadas
            à natureza e à vida selvagem do Ártico.
        </div>

        <div>
            Tromsø também possui diversos eventos e festivais culturais.
        </div>

    </div>

</section>


<!-- OUTROS PROJETOS -->

<section class="outros-projetos">

    <h2>
        Outros <span>Projetos</span>
    </h2>

    <p>
        Conheça também os outros projetos deste site.
    </p>


    <div class="botoes-projetos">


        <a href="proj3.html" class="botao-projeto">

            <span>
                Jude Bellingham
            </span>

            <strong>
                →
            </strong>

        </a>


        <a href="proj2.html" class="botao-projeto">

            <span>
                Hip-Hop / Rap
            </span>

            <strong>
                →
            </strong>

        </a>


    </div>

</section>


<!-- RODAPÉ -->

<footer>

    <p>
        Site sobre <strong>Tromsø, Noruega</strong>
    </p>

    <p style="margin-top:8px;">
        Projeto escolar • 2026
    </p>

</footer>


</body>

</html>
